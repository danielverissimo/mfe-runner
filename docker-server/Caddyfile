mferunner.com {
	encode zstd gzip

	header {
		Cache-Control "no-cache"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/releases {
		rewrite * /repos/danielverissimo/mfe-runner/releases?per_page=30
		reverse_proxy https://api.github.com {
			header_up Host api.github.com
			header_up Accept "application/vnd.github+json"
			header_up X-GitHub-Api-Version "2022-11-28"
		}
		header Cache-Control "public, max-age=60"
	}

	@legacyDownloads path /mfe-runner /mfe-runner/*
	handle @legacyDownloads {
		redir https://github.com/danielverissimo/mfe-runner/releases/latest 302
	}

	handle {
		root * /srv/mferunner
		file_server
	}

	log {
		output stdout
		format json
	}
}

www.mferunner.com {
	redir https://mferunner.com{uri} permanent
}

# Compatibilidade transitória com instalações 0.1.0 publicadas antes do domínio.
177.73.48.206 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	redir https://mferunner.com{uri} permanent
}
